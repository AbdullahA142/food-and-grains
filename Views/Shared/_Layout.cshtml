<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Food_and_Grains</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Food_and_Grains.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
            body {
                background-color: #f5f7f2;
            }

            body {
                padding-top: 80px;
            }

            .navbar {
                background-color: #2e7d32 !important;
            }

            .navbar {
                position: fixed;
                top: 0;
                width: 100%;
                z-index: 1000;
                box-shadow: 0px 2px 10px rgba(0,0,0,0.3);
            }

            .navbar {
                background: linear-gradient(to right, #0f5f00, #38b000);
            }

            .navbar {
                position: fixed;
                top: 0;
                width: 100%;
                z-index: 1000;
            }

            .navbar-brand, .nav-link {
                color: white !important;
                font-weight: bold;
            }

            .btn-custom {
                background-color: #4caf50;
                color: white;
                border: none;
            }

            .btn-custom:hover {
                background-color: #388e3c;
            }

            .card-box {
                background: white;
                padding: 20px;
                border-radius: 10px;
                box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
            }

            .header-img {
                width: 100%;
                height: 200px;
                object-fit: cover;
                border-radius: 10px;
                margin-bottom: 20px;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark" style="background-color:#1b5e20;">
            <div class="container">

                <a class="navbar-brand fw-bold" href="/">🌾 Food & Grains</a>

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link text-white" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Food">Food List</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Food/Create">Add Food</a>
                    </li>

                </ul>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="text-center mt-4 p-3 bg-dark text-white">
        © 2026 Food and Grains | Developed by Md Abdullah Ansari
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
